{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "asan",
      "displayName": "address + undefined sanitizers",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HAMMER_SANITIZE": "address"
      }
    },
    {
      "name": "tsan",
      "displayName": "thread sanitizer",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HAMMER_SANITIZE": "thread"
      }
    },
    {
      "name": "release",
      "displayName": "optimized, no sanitizers",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HAMMER_SANITIZE": "off"
      }
    }
  ],
  "buildPresets": [
    { "name": "asan", "configurePreset": "asan", "configuration": "Debug" },
    { "name": "tsan", "configurePreset": "tsan", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
